# Local development only. Copy this file to .env and replace every placeholder value.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me-db-password
DB_NAME=realtime_orders
DB_PORT=3306
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=dbserver.realtime_orders.orders

# Comma-separated API keys. Use a secret manager or injected environment variables in staging and production.
API_KEYS=change-me-user-key
INTERNAL_API_KEYS=change-me-internal-key

# Explicit CORS allowlist. Add every browser origin that should be allowed to call the backend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

APP_ENV=development
REQUIRE_HTTPS=false
HTTP_RATE_LIMIT_REQUESTS=120
HTTP_RATE_LIMIT_WINDOW_SECONDS=60
WEBSOCKET_CONNECTION_LIMIT=20
WEBSOCKET_CONNECTION_WINDOW_SECONDS=60
LOG_FILE=server.log